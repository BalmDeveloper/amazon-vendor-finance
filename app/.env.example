# Snowflake (service user SALES_APP_SVC, created by ../sql/setup.sql)
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USER=SALES_APP_SVC
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=SALES_APP_ROLE
SNOWFLAKE_WAREHOUSE=SALES_INTELLIGENCE_WH
SNOWFLAKE_DATABASE=SALES_INTELLIGENCE
SNOWFLAKE_SCHEMA=APP

# Snowflake managed MCP server (hyphens, not underscores, in the hostname)
SNOWFLAKE_MCP_URL=https://<org>-<account>.snowflakecomputing.com/api/v2/databases/SALES_INTELLIGENCE/schemas/DATA/mcp-servers/SALES_INTELLIGENCE_MCP

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Vercel Sandbox: on Vercel OIDC is automatic. Locally run `vercel link && vercel env pull`
# (writes VERCEL_OIDC_TOKEN), or set an access token + ids:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
